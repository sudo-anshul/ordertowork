{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {"Service": "ecs-tasks.amazonaws.com"},
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {"aws:SourceAccount": "REPLACE_ACCOUNT_ID"},
        "ArnLike": {"aws:SourceArn": "arn:aws:ecs:REPLACE_REGION:REPLACE_ACCOUNT_ID:*"}
      }
    }
  ]
}
