OTW_ENVIRONMENT=development
OTW_DATABASE_URL=postgresql+psycopg://ordertowork:ordertowork@localhost:55432/ordertowork
OTW_APP_URL=http://localhost:5173
OTW_AUTH_MODE=development
# Reference mode is an explicitly labeled deterministic local harness, not an AI model.
# Use bedrock and an accessible model/profile ID to run the real Strands agent.
OTW_AGENT_MODE=reference
OTW_AWS_REGION=us-east-1
OTW_BEDROCK_MODEL_ID=
OTW_STORAGE_MODE=local
OTW_COGNITO_REGION=us-east-1
OTW_COGNITO_USER_POOL_ID=
OTW_COGNITO_CLIENT_ID=
OTW_COGNITO_CLIENT_SECRET=
OTW_COGNITO_DOMAIN=
# Comma-separated verified provider subjects. Never email addresses.
OTW_PLATFORM_ADMIN_SUBJECTS=
OTW_S3_BUCKET=
OTW_MAX_DAILY_AGENT_JOBS=100
